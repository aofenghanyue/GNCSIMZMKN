    {"id": "runtime_numerics_lead", "assignee": "r0-validation-agent", "reviewer": "r0-po-agent", "required": true},
    {"id": "evidence_workflow_lead", "assignee": "r0-validation-agent", "reviewer": "r0-po-agent", "required": true},
    {"id": "application_lead", "assignee": null, "reviewer": null, "required": false},
