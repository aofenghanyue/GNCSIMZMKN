{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.gnczmkn/schemas/fixture-manifest/1",
  "title": "GNCZMKN reference fixture manifest",
  "description": "R0 fixture contract. It records identity, provenance, expected facts and tolerance before a bundle becomes executable.",
  "x-maturity": "Fixture",
  "type": "object",
  "required": [
    "schema_version",
    "fixture_id",
    "status",
    "purpose",
    "authority",
    "provenance",
    "expected_facts",
    "required_artifacts",
    "acceptance"
  ],
  "properties": {
    "schema_version": {"const": "gnczmkn.fixture-manifest/1"},
    "fixture_id": {
      "type": "string",
      "pattern": "^REF-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "status": {
      "enum": ["specification_only", "capturing", "executable", "qualified", "retired"]
    },
    "purpose": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "provenance": {
      "type": "object",
      "required": ["source_refs"],
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "expected_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "tolerance_policy"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FACT-[A-Z0-9][A-Z0-9_.-]*$"
          },
          "claim": {"type": "string", "minLength": 1},
          "tolerance_policy": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "open_tasks": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(B0|R[0-8])-[A-Z]+-[0-9]{3}$"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
