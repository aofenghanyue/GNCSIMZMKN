{
  "schema_version": "gnczmkn.yyz-scalar-burn-mass-cases/1",
  "fixture_id": "REF-YYZ-SCALAR-BURN-MASS-001",
  "oracle_id": "ORACLE-YYZ-SCALAR-BURN-MASS-001",
  "model_choice": {
    "status": "accepted",
    "owner_role": "scientific_authority",
    "accepted_scope": "Fixture-local sampled scalar-burn MassState evolution. A nonnegative MassFlowInterval reduces positive committed mass at the next boundary while the body-origin-to-CoM coordinate and full inertia about the CoM remain exactly constant under a dedicated model identity.",
    "equations": [
      "interval_duration = (valid_until_tick - valid_from_tick) * base_dt",
      "consumed_mass = fuel_consumption_rate * interval_duration",
      "candidate_mass = committed_mass - consumed_mass",
      "candidate_r_body_origin_to_CoM_B = committed_r_body_origin_to_CoM_B",
      "candidate_inertia_about_CoM_B = committed_inertia_about_CoM_B",
      "next_committed_MassState = candidate_MassState at valid_until_tick"
    ],
    "visibility_policy": "The committed sample remains visible throughout the half-open interval. The candidate becomes the committed MassState only at valid_until_tick.",
    "positivity_policy": "Current and candidate mass must both be strictly positive. Depletion is rejected without a clamp or dry-mass substitution.",
    "geometry_policy": "The model holds the supplied CoM point coordinate and every entry of the symmetric-positive-definite inertia tensor exactly constant. This fixture-local approximation has its own model identity and does not claim tank geometry.",
    "excluded": [
      "fuel volume, tank geometry, slosh, ablation and center-of-mass motion",
      "dry mass, depletion event handling and rate limiting",
      "configuration jumps, attachment, separation and parallel-axis transfer",
      "canonical vehicle assets and product contracts",
      "R1-R8 runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-SCALAR-BURN-CONSTANT-GEOMETRY-001",
    "mass_state_id": "mass.fixture.yyz.vehicle@1",
    "body_frame_id": "frame.fixture.yyz.body@1",
    "body_origin_point_id": "point.fixture.yyz.body-origin@1",
    "center_of_mass_point_id": "point.fixture.yyz.center-of-mass@1",
    "clock_domain": "clock.fixture.yyz.simulation@1",
    "quality": "Valid",
    "strategy": "SampledIntervalCandidate",
    "validity_domain": [
      "all supplied and derived physical values are finite",
      "configuration revision and ticks are nonnegative integers",
      "sample_tick = valid_from_tick and valid_until_tick > valid_from_tick",
      "base_dt_s > 0 and fuel_consumption_rate_kgps >= 0",
      "committed_mass_kg > 0 and candidate_mass_kg > 0",
      "CoM is a finite body-frame point coordinate and inertia about the CoM is symmetric positive definite",
      "MassState, body frame, clock, revision and interval identities agree",
      "next sample tick equals valid_until_tick and next_valid_until_tick is later"
    ]
  },
  "tolerances": {
    "formula_absolute": 2e-12,
    "formula_relative": 2e-12,
    "stored_decimal_absolute": "1e-68"
  },
