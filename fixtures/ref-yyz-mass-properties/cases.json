  "semantic_profile": {
    "status": "implemented-from-accepted-invariants",
    "authority_basis": [
      "ADR-0006 accepted SI, point/free-vector, frame and half-open validity semantics",
      "accepted REF-YYZ-6DOF-CORE-001 positive-mass and symmetric-positive-definite inertia domain",
      "accepted REF-YYZ-FORCE-MOMENT-CLOSURE-001 center-of-mass application-vector convention",
      "accepted REF-YYZ-PROPULSION-RESPONSE-001 scalar mass candidate sign and interval semantics",
      "architecture 14 section 18.1 current-sample versus interval-candidate visibility"
    ],
    "implemented_scope": "Fixture-local projection of explicit committed MassState into MassPropertiesSample, direct Closure and rigid-core consumer links, and current-versus-candidate publication timing.",
    "equations": [
      "MassPropertiesSample@t_k = project(explicit committed MassState_k)",
      "r_CoM_to_application_B = r_body_origin_to_application_B - r_body_origin_to_CoM_B",
      "lever_arm_moment_B = r_CoM_to_application_B x force_B",
      "moment_about_CoM_B = intrinsic_moment_at_application_B + lever_arm_moment_B",
      "specific_force_B = force_B / mass",
      "angular_momentum_B = inertia_about_CoM_B * omega_B",
      "gyroscopic_moment_B = omega_B x angular_momentum_B",
      "angular_acceleration_B = inertia_about_CoM_B^-1 * (moment_about_CoM_B - gyroscopic_moment_B)"
    ],
    "temporal_policy": "The current committed sample is visible throughout its FrozenInterval. A pending scalar mass candidate remains candidate-only and can appear in projection only after the declared next-boundary commit.",
    "inertia_policy": "The sample carries the full finite symmetric-positive-definite inertia tensor about the current center of mass, expressed in the declared body frame. Products of inertia are preserved.",
    "unresolved_choice": "How a MassFlowInterval derives candidate center of mass and inertia is intentionally unimplemented and still requires Scientific Authority selection.",
    "excluded": [
      "a fuel, ablation, dry-mass, center-of-mass or inertia evolution law",
      "configuration jumps, attachment/separation and parallel-axis transfer",
      "canonical vehicle geometry, tanks, assets and applicability",
      "R1-R8 product contracts or runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-MASS-PROPERTIES-PROJECTION-001",
    "mass_state_id": "mass.fixture.yyz.vehicle@1",
    "body_frame_id": "frame.fixture.yyz.body@1",
    "body_origin_point_id": "point.fixture.yyz.body-origin@1",
    "center_of_mass_point_id": "point.fixture.yyz.center-of-mass@1",
    "clock_domain": "clock.fixture.yyz.simulation@1",
    "quality": "Valid",
    "strategy": "FrozenInterval",
    "execution_form": "fixture-local-committed-state-projection",
    "validity_domain": [
      "all supplied and derived physical values are finite",
      "sample_tick, valid_from_tick and configuration_revision are nonnegative integers",
      "sample_tick = valid_from_tick and valid_until_tick > valid_from_tick",
      "mass_kg > 0",
      "r_body_origin_to_CoM_B is a body-frame point coordinate relative to the declared body origin",
      "inertia_about_CoM_B is finite, symmetric and positive definite",
      "pending candidate and explicit next committed state agree on next tick and mass",
      "current and next projections each retain their own exact state, frame, clock and revision identity"
    ]
  },
  "tolerances": {
    "formula_absolute": 2e-12,
