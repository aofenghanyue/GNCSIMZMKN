  "model_choice": {
    "status": "accepted",
    "owner_role": "scientific_authority",
    "accepted_scope": "Fixture-local inertial-Cartesian rigid-body core with supplied uniform gravity, constant positive mass, constant symmetric positive-definite body inertia, total body force applied at the center of mass, total body moment about the center of mass, and passive Hamilton q_I_B attitude.",
    "numerical_policy": "Classical fixed-step RK4 on the coupled state; normalize q_I_B before every derivative evaluation and before commit, record the pre-commit norm residual, and discard the whole candidate on any domain failure.",
    "excluded": [
      "canonical 00A or Legacy mission selection",
      "Earth, atmosphere, wind, aero, propulsion, guidance, control, allocation, actuator, configuration and variable-mass models",
      "canonical YYZ terminal, pitch-overshoot metric and production acceptance tolerances",
      "R1-R8 product types or runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-6DOF-RIGID-CORE-001",
    "inertial_frame_id": "frame.fixture.yyz.inertial-cartesian@1",
    "body_frame_id": "frame.fixture.yyz.body@1",
    "attitude": {
      "identity": "q_I_B",
      "direction": "passive body-to-inertial coordinate transform",
      "algebra": "Hamilton",
      "storage_order": ["w", "x", "y", "z"],
      "body_rate_identity": "omega_BI_B"
    },
    "state_equations": [
      "r_dot_I = v_I",
      "v_dot_I = R_I_B(q_I_B) * force_B / mass + gravity_I",
      "q_dot_I_B = -0.5 * pure(omega_BI_B) o q_I_B",
      "omega_dot_BI_B = inertia_B^-1 * (moment_B - omega_BI_B x (inertia_B * omega_BI_B))"
    ],
    "validity_domain": [
      "all inputs and derived values are finite",
      "mass is strictly positive",
      "inertia_B is constant, symmetric and positive definite",
      "input and committed q_I_B have nonzero norm and are explicitly normalized with a correction flag",
      "force_B acts at the center of mass and moment_B is about the center of mass",
      "gravity_I, force_B and moment_B are constant within each fixture case"
    ],
    "time_policy": {
      "authority": "nonnegative integer tick",
      "grid": "ExactGrid",
      "equation": "t_k = tick * dt"
    }
  },
