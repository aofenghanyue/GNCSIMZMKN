{
  "schema_version": "gnczmkn.yyz-uniform-environment-cases/1",
  "fixture_id": "REF-YYZ-UNIFORM-ENVIRONMENT-001",
  "oracle_id": "ORACLE-YYZ-UNIFORM-ENVIRONMENT-001",
  "model_choice": {
    "status": "accepted",
    "owner_role": "scientific_authority",
    "accepted_scope": "Fixture-local pure environment query returning supplied position- and time-invariant gravity, air-mass velocity, density and speed of sound in one inertial Cartesian frame.",
    "equations": [
      "gravity_I(query) = supplied gravity_I",
      "airmass_velocity_I(query) = supplied airmass_velocity_I",
      "density(query) = supplied density",
      "speed_of_sound(query) = supplied speed_of_sound",
      "v_relative_I = v_vehicle_I - airmass_velocity_I",
      "qbar = 0.5 * density * dot(v_relative_I, v_relative_I)",
      "Mach = norm(v_relative_I) / speed_of_sound",
      "acceleration_I = force_I / mass + gravity_I"
    ],
    "domain_policy": "Definition, query and consumer-link values are finite; query frame, clock and configuration revision match the definition; sample tick and revision are nonnegative; density is nonnegative; speed of sound, consumer mass and consumer relative speed are strictly positive.",
    "excluded": [
      "Earth shape, rotation, geodetic conversion and geopotential altitude",
      "altitude-dependent atmosphere or gravity",
      "pressure, temperature, humidity and viscosity",
      "wind profiles, gusts, perturbations and derivatives",
      "canonical constants, canonical environment applicability and assets",
      "public product contracts and R1-R8 runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-UNIFORM-ENVIRONMENT-001",
    "inertial_frame_id": "frame.fixture.yyz.inertial-cartesian@1",
    "clock_domain": "clock.fixture.yyz.simulation@1",
    "quality": "Valid",
    "query_execution_form": "fixture-local-pure-query",
    "physical_response_invariance": "independent of finite query position and nonnegative sample tick",
    "validity_domain": [
      "all supplied and derived scalar values are finite",
      "density_kgpm3 >= 0",
      "speed_of_sound_mps > 0",
      "query position uses the declared inertial frame",
      "query and consumer samples use the declared clock, tick and configuration revision"
    ]
  },
  "tolerances": {
    "formula_absolute": 2e-12,
    "formula_relative": 2e-12,
    "stored_decimal_absolute": "1e-68"
  },
