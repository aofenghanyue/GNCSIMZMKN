  "model_choice": {
    "status": "accepted",
    "owner_role": "scientific_authority",
    "accepted_scope": "Fixture-local dimensionalization of supplied body-axis aerodynamic coefficients with explicit reference geometry, aerodynamic reference point and a closure-ready center-of-mass wrench.",
    "body_axes": "right-handed x-forward, y-right, z-down",
    "coefficient_order": ["C_A", "C_Y", "C_N", "C_l", "C_m", "C_n"],
    "equations": [
      "F_B = qbar * S_ref * [-C_A, C_Y, -C_N]",
      "M_aero_ref_B = qbar * S_ref * [b_ref*C_l, c_ref*C_m, b_ref*C_n]",
      "M_CoM_B = M_aero_ref_B + r_CoM_to_aero_ref_B x F_B"
    ],
    "excluded": [
      "coefficient table lookup, interpolation and extrapolation",
      "coefficient asset provenance and canonical applicability",
      "rate, control and actuator derivatives",
      "canonical reference geometry",
      "public product contracts and R1-R8 runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-AERO-DIMENSIONALIZATION-001",
    "body_frame_id": "frame.fixture.yyz.body@1",
    "body_axes": "x-forward_y-right_z-down",
    "clock_domain": "clock.fixture.yyz.simulation@1",
    "coefficient_convention_id": "convention.fixture.yyz.aero-body-axes@1",
    "source_id": "aero.body",
    "application_vector_identity": "r_CoM_to_aero_ref_B",
    "validity_domain": [
      "dynamic pressure is finite and nonnegative",
      "reference area, span and chord are finite and strictly positive",
      "all supplied coefficients and reference-point components are finite",
      "frame, clock, sample tick and configuration revision identities agree"
    ]
  },
  "tolerances": {
