{
  "schema_version": "gnczmkn.yyz-propulsion-response-cases/1",
  "fixture_id": "REF-YYZ-PROPULSION-RESPONSE-001",
  "oracle_id": "ORACLE-YYZ-PROPULSION-RESPONSE-001",
  "model_choice": {
    "status": "accepted",
    "owner_role": "scientific_authority",
    "accepted_scope": "Fixture-local supplied propulsion response with nonnegative thrust magnitude, an explicit unit body-frame direction, an application point, an intrinsic moment at that point, and a nonnegative fuel-consumption interval feeding the accepted Closure and sampled Mass consumers.",
    "equations": [
      "force_B = thrust_magnitude * thrust_direction_B_unit",
      "lever_arm_moment_B = r_CoM_to_application_B x force_B",
      "moment_about_CoM_B = intrinsic_moment_at_application_B + lever_arm_moment_B",
      "interval_duration = (valid_until_tick - valid_from_tick) * base_dt",
      "consumed_fuel_mass = fuel_consumption_rate * interval_duration",
      "mass_delta = -consumed_fuel_mass",
      "mass_candidate = committed_mass + mass_delta"
    ],
    "direction_policy": "Thrust magnitude is nonnegative. Direction is an explicit finite unit free vector expressed in the accepted x-forward/y-right/z-down body frame and uses the Error normalization policy.",
    "moment_policy": "The response carries r_CoM_to_application_B and intrinsic moment_at_application_B. Closure alone transports the wrench to the center of mass.",
    "mass_flow_policy": "fuel_consumption_rate_kgps is a nonnegative consumption magnitude. The sampled Mass consumer subtracts its exact interval integral and rejects a nonpositive candidate without a clamp.",
    "temporal_policy": "PropulsionResponse is sampled at valid_from_tick and its MassFlowInterval is valid on the declared half-open tick interval in one clock domain and configuration revision.",
    "excluded": [
      "throttle or enable mapping, engine dynamics and phase logic",
      "fuel state, dry-mass clamp, fuel exhaustion and ablation",
      "canonical engine assets, configuration transitions and applicability",
      "R1-R8 product contracts or runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-PROPULSION-RESPONSE-001",
    "source_id": "propulsion.main",
    "body_frame_id": "frame.fixture.yyz.body@1",
    "body_axes": "right-handed x-forward/y-right/z-down",
    "clock_domain": "clock.fixture.yyz.simulation@1",
    "mass_state_id": "mass.fixture.yyz.vehicle@1",
    "quality": "Valid",
    "response_execution_form": "fixture-local-supplied-response",
    "validity_domain": [
      "all supplied and derived scalar values are finite",
      "configuration_revision, sample_tick and valid_from_tick are nonnegative integers",
      "valid_until_tick > valid_from_tick and sample_tick = valid_from_tick",
      "base_dt_s > 0",
      "thrust_magnitude_N >= 0",
      "thrust_direction_B_unit has unit norm under the Error policy",
      "fuel_consumption_rate_kgps >= 0",
      "committed_mass_kg > 0 and mass_candidate_kg > 0",
      "response, Closure contribution and Mass consumer identities agree"
    ]
  },
  "tolerances": {
    "formula_absolute": 2e-12,
    "formula_relative": 2e-12,
    "direction_norm_absolute": 1e-12,
    "direction_norm_relative": 1e-12,
    "stored_decimal_absolute": "1e-68"
  },
