  "oracle_id": "ORACLE-YYZ-AIR-DATA-KINEMATICS-001",
  "model_choice": {
    "status": "accepted",
    "owner_role": "scientific_authority",
    "accepted_scope": "Fixture-local supplied air-data kinematics with right-handed x-forward/y-right/z-down body axes, passive-Hamilton inertial-to-body rotation, explicit wind subtraction, unclamped angles, dynamic pressure and Mach number.",
    "equations": [
      "v_rel_I = v_vehicle_I - v_airmass_I",
      "pure(v_rel_B) = q_I_B * pure(v_rel_I) * inverse(q_I_B)",
      "V = sqrt(u^2 + v^2 + w^2)",
      "alpha = atan2(w, u)",
      "beta = atan2(v, sqrt(u^2 + w^2))",
      "qbar = 0.5 * rho * V^2",
      "Mach = V / a"
    ],
    "domain_policy": "All supplied and derived scalars are finite; q_I_B uses the Error normalization policy; rho >= 0; a > 0; V > 0; sqrt(u^2+w^2) > 0. No epsilon, angle-denominator or speed-of-sound clamp is permitted.",
    "rearward_flow_policy": "Rearward flow remains mathematically computable in this slice; a later aerodynamic model may declare a narrower applicability domain.",
    "excluded": [
      "canonical atmosphere, wind, sensor, aerodynamic or product contracts",
      "canonical aero validity ranges and coefficient lookup",
      "R1-R8 product contracts or runtime capability"
    ]
  },
  "model": {
    "model_id": "MODEL-YYZ-AIR-DATA-KINEMATICS-001",
    "inertial_frame_id": "frame.fixture.yyz.inertial-cartesian@1",
    "body_frame_id": "frame.fixture.yyz.body@1",
    "body_axes": "x-forward_y-right_z-down",
    "clock_domain": "clock.fixture.yyz.simulation@1",
    "relative_velocity_identity": "vehicle velocity relative to the air mass",
    "quaternion_identity": "q_I_B",
    "quaternion_wire_order": "wxyz",
    "quaternion_normalization_policy": "Error",
    "alpha_range": "(-pi,pi]",
    "beta_range": "(-pi/2,pi/2)",
    "validity_domain": [
      "all scalar inputs and derived values are finite",
      "truth, wind and atmosphere sample identities equal the declared context",
      "q_I_B is unit within the fixture tolerance under Error policy",
      "density_kgpm3 >= 0",
      "speed_of_sound_mps > 0",
      "speed_mps > 0",
      "horizontal_speed_uw_mps > 0"
    ]
  },
  "tolerances": {
    "formula_absolute": 2e-12,
