    "accepted_scope": "Fixture-local pure body-frame FrozenInterval closure with unique contribution source identity, one configuration revision, one validity interval, force summation, and moment transport from each application point to the center of mass.",
    "equations": [
      "force_total_B = sum(force_B_i)",
      "moment_total_about_CoM_B = sum(moment_at_application_B_i + r_CoM_to_application_B_i x force_B_i)"
    ],
    "gravity_policy": "gravity_I remains an independent inertial acceleration input to the rigid-body form and is excluded from body-force closure",
    "temporal_policy": "all accepted contributions are frozen over the declared half-open tick interval and the resulting total is held through every RK stage",
    "excluded": [
      "canonical aero, propulsion, mass, configuration or gravity models",
      "CandidateState or AlgebraicSolve closure",
      "variable center of mass, variable inertia and mass flow",
      "R1-R8 product contracts or runtime capability"
    ]
  },
