    "application_vector_direction": "point vector from center of mass to force application point",
    "moment_output_identity": "moment_total_about_CoM_B",
    "strategy": "FrozenInterval",
    "validity_domain": [
      "all scalar inputs and derived values are finite",
      "source_id is nonempty and unique within one closure input",
      "every contribution uses the declared body frame",
      "every contribution uses the declared configuration revision",
      "every contribution uses the declared half-open validity interval",
      "gravity is not a force contribution"
    ]
  },
